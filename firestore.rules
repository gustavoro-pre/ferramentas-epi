rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function perfil() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function ativo() { return logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && perfil().ativo == true; }
    function tem(papeis) { return ativo() && perfil().papel in papeis; }

    // configuração inicial (primeiro administrador): só pode ser criada uma vez
    match /config/setup {
      allow read: if true;
      allow create: if logado() && request.resource.data.adminUid == request.auth.uid;
    }
    match /config/empresa { allow read: if ativo(); allow write: if tem(['admin']); }
    match /config/regras  { allow read: if ativo(); allow write: if tem(['admin', 'gerente']); }

    match /usuarios/{uid} {
      allow read: if ativo() || (logado() && request.auth.uid == uid);
      allow create: if tem(['admin'])
        || (logado() && request.auth.uid == uid && request.resource.data.papel == 'admin'
            && getAfter(/databases/$(database)/documents/config/setup).data.adminUid == uid);
      allow update, delete: if tem(['admin']);
    }

    // aprovações de exceção: só gerência
    match /decisoes/{id} { allow read: if ativo(); allow write: if tem(['admin', 'gerente']); }

    match /funcionarios/{id} { allow read: if ativo(); allow write: if tem(['admin', 'gerente', 'almox', 'tst', 'rh']); }
    match /trein_tipos/{id}  { allow read: if ativo(); allow write: if tem(['admin', 'gerente', 'tst', 'rh']); }
    match /treinamentos/{id} { allow read: if ativo(); allow write: if tem(['admin', 'gerente', 'tst', 'rh']); }
    match /kits/{id}         { allow read: if ativo(); allow write: if tem(['admin', 'gerente', 'tst']); }

    match /ferramentas/{id}  { allow read: if ativo(); allow write: if tem(['admin', 'gerente', 'almox']); }
    match /cautelas/{id}     { allow read: if ativo(); allow write: if tem(['admin', 'gerente', 'almox']); }
    match /epis/{id}         { allow read: if ativo(); allow write: if tem(['admin', 'gerente', 'almox', 'tst']); }
    match /entregas/{id}     { allow read: if ativo(); allow write: if tem(['admin', 'gerente', 'almox', 'tst']); }
    match /autorizacoes/{id} { allow read: if ativo(); allow write: if tem(['admin', 'gerente', 'almox', 'tst']); }
    match /notas/{id}        { allow read: if ativo(); allow write: if tem(['admin', 'gerente', 'almox', 'tst']); }
  }
}
